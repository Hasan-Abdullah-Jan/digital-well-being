# =====================================================================
#  LUMI — ALL KEYS AND SETTINGS IN ONE PLACE
# ---------------------------------------------------------------------
#  1. Copy this file to config/.env   (cp config/.env.example config/.env)
#  2. Replace every [PASTE HERE] with your value (no quotes needed).
#  3. Restart the dev server: npx expo start -c
#
#  config/.env is git-ignored, so your real values are never committed.
#  Anything left as [PASTE HERE] is treated as "not set": the app still
#  runs, in demo / offline mode for that feature.
#  Step-by-step help for every line: docs/SETUP_GUIDE.md
# =====================================================================

# ---------- Firebase (Project settings > General > Your apps) ----------
# From google-services.json: client[0].api_key[0].current_key
FIREBASE_API_KEY=[PASTE HERE]
# Usually <project_id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=[PASTE HERE]
# From google-services.json: project_info.project_id
FIREBASE_PROJECT_ID=[PASTE HERE]
# From google-services.json: project_info.storage_bucket
FIREBASE_STORAGE_BUCKET=[PASTE HERE]
# From google-services.json: project_info.project_number
FIREBASE_MESSAGING_SENDER_ID=[PASTE HERE]
# From google-services.json: client[0].client_info.mobilesdk_app_id
# (or the "App ID" of a Web app registered in the same Firebase project)
FIREBASE_APP_ID=[PASTE HERE]

# ---------- Help and safety (shown on the HELP screen) ----------
# A phone number (+15551234567), a website (https://...), an email
# (mailto:help@example.org) or an SMS short code (sms:12345).
HELPLINE_OR_TRUSTED_CONTACT=[PASTE HERE]
# Friendly name shown on the button, e.g. "Youth Helpline" or "School wellbeing team"
HELPLINE_NAME=[PASTE HERE]
# Optional: a separate text/SMS number for the same service
HELPLINE_TEXT_NUMBER=[PASTE HERE]
# Optional: a website or chat page for the same service
HELPLINE_WEBSITE=[PASTE HERE]
# Your local emergency number, e.g. 112, 911, 999, 000
EMERGENCY_NUMBER=[PASTE HERE]
# Directory of free helplines worldwide (used when nothing above is set)
HELPLINE_DIRECTORY_URL=https://findahelpline.com

# ---------- Optional organisation details (privacy screen) ----------
ORGANISATION_NAME=[PASTE HERE]
PRIVACY_CONTACT_EMAIL=[PASTE HERE]

# ---------- Feature switches ----------
# Anonymous, moderated peer-support space (needs Firebase)
PEER_SPACE_ENABLED=true
# true = never connect to Firebase, always use demo data (good for presentations)
DEMO_MODE_ONLY=false

# ---------- Developers only ----------
# true = talk to the local Firebase Emulator Suite instead of the real project
USE_FIREBASE_EMULATORS=false
FIREBASE_EMULATOR_HOST=127.0.0.1
# Change only if you change the IDs registered in Firebase / App Store
ANDROID_PACKAGE=digital_wellbeing.app
IOS_BUNDLE_ID=app.digitalwellbeing.lumi
