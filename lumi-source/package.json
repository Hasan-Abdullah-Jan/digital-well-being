{
  "name": "lumi",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "demo": "DEMO_MODE_ONLY=true expo start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && node scripts/check-i18n.mjs",
    "export:web": "expo export --platform web --clear",
    "export:android": "expo export --platform android --clear",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "deploy:web": "expo export --platform web --clear && npx firebase-tools deploy --only hosting",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules,firestore:indexes",
    "test:rules": "cd firebase && npm install && npm test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test:web": "expo export --platform web --clear && node scripts/smoke-web.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.(wav|mp3)$": "<rootDir>/test/fileStub.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|firebase|@firebase/.*|zustand)"
    ],
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  }
}
