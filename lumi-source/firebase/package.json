{
  "name": "lumi-firestore-rules-tests",
  "private": true,
  "type": "module",
  "description": "Security rules tests for Lumi. Runs against the local Firestore emulator (needs Java 11+).",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-lumi --config ../firebase.json \"node --test tests/rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.0.0"
  }
}
